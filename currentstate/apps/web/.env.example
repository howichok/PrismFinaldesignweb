# PrismMTR Web (Next.js) environment variables

# Base URL used for redirects in Discord OAuth
PRISM_BASE_URL=http://localhost:3000

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional override if your redirect differs from PRISM_BASE_URL
# DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Supabase (server-side service role)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Supabase (client-side realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
