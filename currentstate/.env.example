# ===========================================
# PrismMTR Community Portal - Environment
# ===========================================
# Скопируйте в .env и заполните значения.

# -------------------------------------------
# База данных (Docker Compose по умолчанию)
# -------------------------------------------
# postgres://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql://prismmtr:prismmtr@localhost:5432/prismmtr
DIRECT_URL=postgresql://prismmtr:prismmtr@localhost:5432/prismmtr

# -------------------------------------------
# Redis (кэш Discovery + сессии + OAuth state)
# -------------------------------------------
REDIS_URL=redis://localhost:6379

# -------------------------------------------
# Discord OAuth (серверная авторизация)
# -------------------------------------------
# Создайте приложение: https://discord.com/developers/applications
# Redirect URI (dev): http://localhost:3000/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Опционально: зафиксировать redirect URI явно
# DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# -------------------------------------------
# Веб-приложение
# -------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# Preview / тестовые флаги (не включать в проде)
NEXT_PUBLIC_E2E_TEST_MODE=false
NEXT_PUBLIC_OAUTH_DISABLED=false

# -------------------------------------------
# Discord Webhook для Help-тикетов
# -------------------------------------------
DISCORD_HELP_WEBHOOK_URL=

# -------------------------------------------
# Seed-админ (packages/db/prisma/seed.ts)
# -------------------------------------------
# Discord ID пользователя, которого нужно сделать админом при сидировании
SEED_ADMIN_DISCORD_ID=

# -------------------------------------------
# Примечания по запуску
# -------------------------------------------
# 1) Поднимите инфраструктуру:
#    docker compose up -d
# 2) Сгенерируйте Prisma Client:
#    pnpm db:generate
# 3) Примените миграции (создаст новую миграцию локально):
#    pnpm db:migrate
# 4) (Опционально) Сидирование админа:
#    pnpm db:seed
# 5) Запуск портала:
#    pnpm dev